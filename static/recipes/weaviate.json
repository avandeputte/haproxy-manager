{
  "name": "Weaviate",
  "category": "Databases",
  "summary": "HTTP 8080 checked against its readiness endpoint.",
  "notes": "/v1/.well-known/ready answers 200 once the node can serve queries.",
  "fields": {
    "url": "https://weaviate.example.com",
    "target": "10.0.0.10:8080",
    "balance": "leastconn",
    "persistence": "none",
    "timeout_server": "30m",
    "health": "http",
    "health_uri": "/v1/.well-known/ready",
    "health_status": "200",
    "health_interval": "10s",
    "cert_mode": "auto",
    "http_redirect": true,
    "timeout_connect": "5s"
  }
}
