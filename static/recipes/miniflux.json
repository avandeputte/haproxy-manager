{
  "name": "Miniflux / FreshRSS",
  "category": "Applications",
  "summary": "HTTP 8080 checked with /healthcheck.",
  "notes": "Miniflux answers /healthcheck; for FreshRSS use / and accept any 2xx or 3xx. Fetching a few hundred feeds is what the timeout is for.",
  "fields": {
    "url": "https://rss.example.com",
    "target": "10.0.0.10:8080",
    "balance": "roundrobin",
    "persistence": "source",
    "stick_type": "ip",
    "timeout_server": "30m",
    "health": "http",
    "health_uri": "/healthcheck",
    "health_status": "200",
    "health_interval": "10s",
    "cert_mode": "auto",
    "http_redirect": true,
    "timeout_connect": "5s"
  }
}
