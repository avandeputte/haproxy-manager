{
  "name": "IMAP",
  "category": "Infrastructure",
  "summary": "TCP 993 for mail clients.",
  "notes": "Clients keep an IDLE connection open to be told about new mail, so the timeout must outlast it. Plain TCP, so the TLS is the mail server's.",
  "fields": {
    "url": "tcp://0.0.0.0:993",
    "target": "imap1=10.0.0.1:993, imap2=10.0.0.2:993",
    "balance": "roundrobin",
    "persistence": "source",
    "stick_type": "ip",
    "health": "tcp",
    "health_interval": "10s",
    "timeout_server": "1h",
    "timeout_connect": "5s"
  },
  "order": 178
}
