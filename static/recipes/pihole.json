{
  "name": "Pi-hole",
  "category": "Infrastructure",
  "summary": "HTTP 80 for the admin interface.",
  "notes": "The interface lives under /admin, and DNS is UDP 53 which cannot be proxied here -- point clients at the Pi-hole directly for that.",
  "fields": {
    "url": "https://pihole.example.com",
    "target": "10.0.0.10:80",
    "balance": "roundrobin",
    "persistence": "source",
    "stick_type": "ip",
    "timeout_server": "10m",
    "health": "http",
    "health_uri": "/admin/",
    "health_status": "",
    "health_interval": "10s",
    "cert_mode": "auto",
    "http_redirect": true,
    "timeout_connect": "5s"
  }
}
