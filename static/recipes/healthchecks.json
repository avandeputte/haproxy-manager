{
  "name": "Healthchecks",
  "category": "Applications",
  "summary": "HTTP 8000 for cron monitoring.",
  "notes": "Jobs ping this to say they ran, so it needs to be reachable from wherever they run. The check accepts any 2xx or 3xx.",
  "fields": {
    "url": "https://hc.example.com",
    "target": "10.0.0.10:8000",
    "balance": "roundrobin",
    "persistence": "none",
    "timeout_server": "10m",
    "health": "http",
    "health_uri": "/",
    "health_status": "",
    "health_interval": "10s",
    "cert_mode": "auto",
    "http_redirect": true,
    "timeout_connect": "5s"
  }
}
