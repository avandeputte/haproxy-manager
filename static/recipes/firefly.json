{
  "name": "Firefly III",
  "category": "Applications",
  "summary": "HTTP 8080 checked with /health.",
  "notes": "Sessions are server-side, so clients are pinned. Importing a bank export is one long request.",
  "fields": {
    "url": "https://firefly.example.com",
    "target": "10.0.0.10:8080",
    "balance": "roundrobin",
    "persistence": "source",
    "stick_type": "ip",
    "timeout_server": "30m",
    "health": "http",
    "health_uri": "/health",
    "health_status": "200",
    "health_interval": "10s",
    "cert_mode": "auto",
    "http_redirect": true,
    "timeout_connect": "5s"
  }
}
