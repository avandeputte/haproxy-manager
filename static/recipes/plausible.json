{
  "name": "Plausible",
  "category": "Applications",
  "summary": "HTTP 8000 checked with /api/health.",
  "notes": "/api/health reports whether the database and cache are reachable. Tracking requests are small and frequent.",
  "fields": {
    "url": "https://plausible.example.com",
    "target": "10.0.0.10:8000",
    "balance": "leastconn",
    "persistence": "none",
    "timeout_server": "10m",
    "health": "http",
    "health_uri": "/api/health",
    "health_status": "200",
    "health_interval": "10s",
    "cert_mode": "auto",
    "http_redirect": true,
    "timeout_connect": "5s"
  },
  "order": 356
}
