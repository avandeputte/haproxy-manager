{
  "name": "Joplin Server",
  "category": "Applications",
  "summary": "HTTP 22300 checked with /api/ping.",
  "notes": "/api/ping answers without a login. Syncing a large notebook uploads many items in one session.",
  "fields": {
    "url": "https://joplin.example.com",
    "target": "10.0.0.10:22300",
    "balance": "roundrobin",
    "persistence": "none",
    "timeout_server": "1h",
    "health": "http",
    "health_uri": "/api/ping",
    "health_status": "200",
    "health_interval": "10s",
    "cert_mode": "auto",
    "http_redirect": true,
    "timeout_connect": "5s"
  }
}
