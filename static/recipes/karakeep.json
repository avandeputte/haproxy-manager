{
  "name": "Karakeep / Hoarder",
  "category": "Applications",
  "summary": "HTTP 3000 for bookmarks.",
  "notes": "Saving a link fetches the page and may run it through a model, so the timeout is generous.",
  "fields": {
    "url": "https://bookmarks.example.com",
    "target": "10.0.0.10:3000",
    "balance": "roundrobin",
    "persistence": "source",
    "stick_type": "ip",
    "timeout_server": "30m",
    "health": "http",
    "health_uri": "/",
    "health_status": "",
    "health_interval": "10s",
    "cert_mode": "auto",
    "http_redirect": true,
    "timeout_connect": "5s"
  },
  "order": 351
}
