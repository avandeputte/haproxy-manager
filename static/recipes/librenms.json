{
  "name": "LibreNMS",
  "category": "Applications",
  "summary": "HTTP 8000 for the interface.",
  "notes": "Polling happens on the server itself; this publishes the interface. Large graphs and reports are what the timeout is for.",
  "fields": {
    "url": "https://librenms.example.com",
    "target": "10.0.0.10:8000",
    "balance": "roundrobin",
    "persistence": "source",
    "stick_type": "ip",
    "timeout_server": "30m",
    "health": "http",
    "health_uri": "/",
    "health_status": "",
    "health_interval": "10s",
    "cert_mode": "auto",
    "http_redirect": true,
    "timeout_connect": "5s"
  }
}
