{
  "name": "Wallabag",
  "category": "Applications",
  "summary": "HTTP 80 for read-it-later.",
  "notes": "Saving an article fetches and renders the page server-side, which is what the timeout is for. Sessions are server-side, so clients are pinned.",
  "fields": {
    "url": "https://wallabag.example.com",
    "target": "10.0.0.10:80",
    "balance": "roundrobin",
    "persistence": "source",
    "stick_type": "ip",
    "timeout_server": "30m",
    "health": "http",
    "health_uri": "/",
    "health_status": "",
    "health_interval": "10s",
    "cert_mode": "auto",
    "http_redirect": true,
    "timeout_connect": "5s"
  }
}
