#!/bin/sh
# systemctl(1) shim for the container image.
#
# app.py drives services with four calls:
#   systemctl is-active <unit>
#   systemctl is-enabled <unit>     (the watchdog: leave a disabled unit alone)
#   systemctl reload-or-restart <unit>
#   systemctl restart <unit>
# This maps them onto supervisorctl. HAProxy is reloaded with SIGUSR2 (seamless
# master-worker reload, keeps established connections); Keepalived with SIGHUP.
set -u

SUPERVISORCTL="supervisorctl -c /etc/supervisor/supervisord.conf"

action="${1:-}"
unit="${2:-}"
unit="${unit%.service}"

state() {
    # supervisorctl status prints: "<name> <STATE> <detail...>"
    $SUPERVISORCTL status "$1" 2>/dev/null | awk '{print $2}'
}

case "$action" in
    is-active)
        case "$(state "$unit")" in
            RUNNING)  echo active;      exit 0 ;;
            STARTING) echo activating;  exit 3 ;;
            FATAL|BACKOFF) echo failed; exit 3 ;;
            STOPPED|EXITED|STOPPING) echo inactive; exit 3 ;;
            *)        echo unknown;     exit 4 ;;
        esac
        ;;
    reload|reload-or-restart|try-restart)
        # supervisor reports STARTING for the first `startsecs` of a program's
        # life. Treating that as "not running" made an Apply in those seconds
        # fall through to `start`, which is a no-op for an already-started
        # program: the reload was skipped while Apply still reported success.
        waited=0
        while [ "$(state "$unit")" = "STARTING" ] && [ "$waited" -lt 15 ]; do
            sleep 1
            waited=$((waited + 1))
        done
        if [ "$(state "$unit")" = "RUNNING" ]; then
            case "$unit" in
                haproxy)    sig=USR2 ;;
                keepalived) sig=HUP ;;
                *)          sig="" ;;
            esac
            if [ -z "$sig" ]; then
                $SUPERVISORCTL restart "$unit"
            else
                # Report a failed signal instead of swallowing it, so Apply
                # cannot claim a reload that never happened.
                out="$($SUPERVISORCTL signal "$sig" "$unit" 2>&1)"
                echo "$out"
                case "$out" in
                    *signalled*) : ;;
                    *) exit 1 ;;
                esac
            fi
        else
            [ "$action" = "try-restart" ] && exit 0
            $SUPERVISORCTL start "$unit"
        fi
        ;;
    restart)
        if [ "$(state "$unit")" = "RUNNING" ]; then
            $SUPERVISORCTL restart "$unit"
        else
            $SUPERVISORCTL start "$unit"
        fi
        ;;
    start|stop)
        $SUPERVISORCTL "$action" "$unit"
        ;;
    status)
        $SUPERVISORCTL status "$unit"
        ;;
    daemon-reload|enable|disable|is-enabled)
        # No units to (re)generate in a container -- succeed quietly.
        exit 0
        ;;
    *)
        echo "systemctl shim: unsupported action '$action'" >&2
        exit 1
        ;;
esac
